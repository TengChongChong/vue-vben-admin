## 5. 设计模式约定

### 5.1 组合式函数模式

```typescript
// ✅ 命名：use 开头
// ✅ 返回：只暴露需要的状态和方法
// ✅ 单一职责：一个 composable 只做一件事

export function usePagination(fetchFn: FetchFunction) {
  const page = ref(1);
  const pageSize = ref(10);
  const total = ref(0);
  // ... 逻辑
  return { page, pageSize, total, goToPage, changeSize };
}
```

### 5.2 表现组件 vs 容器组件

```typescript
// 表现组件（Presentational）：只负责渲染，通过 props 接收数据
// 位置：components/ui/ 或 components/common/
<DataTable :columns="columns" :data="data" @sort="handleSort" />

// 容器组件（Container）：负责数据获取和状态管理
// 位置：views/<module>/components/
<UserListPage />
```

### 5.3 错误边界

```vue
<!-- 使用 onErrorCaptured 处理子组件错误 -->
<script setup lang="ts">
import { onErrorCaptured, ref } from 'vue';

const error = ref<Error | null>(null);

onErrorCaptured((err) => {
  error.value = err;
  return false; // 阻止错误继续向上传播
});
</script>
```

